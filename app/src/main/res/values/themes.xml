<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema único (escuro, feltro de mesa). O visual é a identidade do app,
         por isso não existe versão clara/escura separada. -->
    <style name="Base.Theme.Truco" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_felt</item>
        <item name="android:fontFamily">@font/silkscreen</item>
        <item name="fontFamily">@font/silkscreen</item>

        <item name="colorPrimary">@color/red</item>
        <item name="colorOnPrimary">@color/cream</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/cream</item>
        <item name="colorError">@color/error_text</item>

        <item name="android:textColorPrimary">@color/cream</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_dim</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="textInputStyle">@style/Truco.TextInput</item>
        <item name="materialAlertDialogTheme">@style/Truco.MaterialDialog</item>
    </style>

    <style name="Theme.Truco" parent="Base.Theme.Truco" />

    <!-- Diálogos (AlertDialog) -->
    <style name="Truco.MaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:fontFamily">@font/silkscreen</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/cream</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="android:textColorPrimary">@color/cream</item>
        <item name="android:textColorSecondary">@color/cream</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>
