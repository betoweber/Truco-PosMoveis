<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDE7"
    tools:context=".TrucoActivity">

    <TextView
        android:id="@+id/tvNomeJ1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/nome_jogador_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPtsJ1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/pontuacao_jogador_1"
        app:layout_constraintBottom_toBottomOf="@+id/tvNomeJ1"
        app:layout_constraintStart_toEndOf="@+id/tvNomeJ1"
        app:layout_constraintTop_toTopOf="@+id/tvNomeJ1" />

    <ImageButton
        android:id="@+id/btnJ1Um"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/um"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNomeJ1"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ1Tres"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:contentDescription="@string/truco"
        app:layout_constraintStart_toEndOf="@+id/btnJ1Um"
        app:layout_constraintTop_toTopOf="@+id/btnJ1Um"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ1Seis"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:contentDescription="@string/seis"
        app:layout_constraintStart_toEndOf="@+id/btnJ1Tres"
        app:layout_constraintTop_toTopOf="@+id/btnJ1Tres"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ1Nove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:contentDescription="@string/nove"
        app:layout_constraintStart_toEndOf="@+id/btnJ1Seis"
        app:layout_constraintTop_toTopOf="@+id/btnJ1Seis"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ1Doze"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:contentDescription="@string/doze"
        app:layout_constraintStart_toEndOf="@+id/btnJ1Nove"
        app:layout_constraintTop_toTopOf="@+id/btnJ1Nove"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <TextView
        android:id="@+id/tvNomeJ2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/nome_jogador_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPtsJ2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/pontuacao_jogador_2"
        app:layout_constraintBottom_toBottomOf="@+id/tvNomeJ2"
        app:layout_constraintEnd_toStartOf="@+id/tvNomeJ2"
        app:layout_constraintTop_toTopOf="@+id/tvNomeJ2" />

    <ImageButton
        android:id="@+id/btnJ2Um"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/um"
        app:layout_constraintBottom_toBottomOf="@+id/btnJ2Tres"
        app:layout_constraintEnd_toStartOf="@+id/btnJ2Tres"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ2Tres"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnJ2Seis"
        app:layout_constraintEnd_toStartOf="@+id/btnJ2Seis"
        android:contentDescription="@string/truco"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ2Seis"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/seis"
        app:layout_constraintBottom_toBottomOf="@+id/btnJ2Nove"
        app:layout_constraintEnd_toStartOf="@+id/btnJ2Nove"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ2Nove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnJ2Doze"
        app:layout_constraintEnd_toStartOf="@+id/btnJ2Doze"
        android:contentDescription="@string/nove"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <ImageButton
        android:id="@+id/btnJ2Doze"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toTopOf="@+id/tvNomeJ2"
        app:layout_constraintEnd_toEndOf="@+id/tvNomeJ2"
        android:contentDescription="@string/doze"
        tools:srcCompat="@tools:sample/avatars"
        android:onClick="btnPontuarOnClick" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnZerar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/btn_zerar_historico"
        app:layout_constraintEnd_toStartOf="@+id/btnHistorico"
        app:layout_constraintTop_toTopOf="@+id/btnHistorico"
        app:srcCompat="@android:drawable/ic_popup_sync"
        android:onClick="btnZerarOnClick" />

    <ImageButton
        android:id="@+id/btnHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/btn_historico_matchup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/btn_star_big_on"
        android:onClick="btnHistoricoOnClick" />

</androidx.constraintlayout.widget.ConstraintLayout>