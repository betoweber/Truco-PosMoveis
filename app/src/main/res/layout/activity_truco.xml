<?xml version="1.0" encoding="utf-8"?>
<!-- Mesa: em retrato os jogadores ficam empilhados; em paisagem, lado a lado
     (a orientação vem de Truco.MesaContainer / Truco.MesaFranja em values e values-land). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/Truco.MesaContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TrucoActivity">

        <!-- ======== Jogador 1 ======== -->
        <LinearLayout
            android:id="@+id/painelJ1"
            style="@style/Truco.MesaPainel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/mesa_margem">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNomeJ1"
                    style="@style/Truco.Tag.J1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="190dp"
                    android:maxLines="1"
                    android:text="@string/nome_jogador_1" />

                <TextView
                    android:id="@+id/tvVitoriasJ1"
                    style="@style/Truco.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    tools:text="VITÓRIAS 0" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/zonaPlacarJ1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Fogo da sequência: desenhado antes da caixa, então fica atrás dela -->
                <ImageView
                    android:id="@+id/ivFogoEsqJ1"
                    style="@style/Truco.Fogo"
                    android:contentDescription="@null"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="-52dp" />

                <ImageView
                    android:id="@+id/ivFogoDirJ1"
                    style="@style/Truco.Fogo"
                    android:contentDescription="@null"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="-52dp"
                    android:rotationY="180" />

                <FrameLayout
                    android:id="@+id/boxPlacarJ1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false">

                    <TextView
                        android:id="@+id/tvPtsJ1"
                        style="@style/Truco.Placar.J1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pontuacao_jogador_1" />

                    <TextView
                        android:id="@+id/tvGanhoJ1"
                        style="@style/Truco.Ganho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-6dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="invisible"
                        tools:text="+3" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnJ1Um"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_1"
                android:contentDescription="@string/um"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_1" />
            <ImageButton
                android:id="@+id/btnJ1Tres"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_3"
                android:contentDescription="@string/truco"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_3" />
            <ImageButton
                android:id="@+id/btnJ1Seis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_6"
                android:contentDescription="@string/seis"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_6" />
            <ImageButton
                android:id="@+id/btnJ1Nove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_9"
                android:contentDescription="@string/nove"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_9" />
            <ImageButton
                android:id="@+id/btnJ1Doze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_12"
                android:contentDescription="@string/doze"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_12" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== Franja central ======== -->
        <LinearLayout
            android:id="@+id/franja"
            style="@style/Truco.MesaFranja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_franja"
            android:gravity="center"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnZerar"
                style="@style/Truco.BotaoIcone"
                android:layout_margin="4dp"
                android:contentDescription="@string/btn_zerar_historico"
                android:onClick="btnZerarOnClick"
                android:src="@drawable/ic_zerar" />

            <ImageButton
                android:id="@+id/btnHistorico"
                style="@style/Truco.BotaoIcone"
                android:layout_margin="4dp"
                android:contentDescription="@string/btn_historico_matchup"
                android:onClick="btnHistoricoOnClick"
                android:src="@drawable/ic_historico" />
        </LinearLayout>

        <!-- ======== Jogador 2 ======== -->
        <LinearLayout
            android:id="@+id/painelJ2"
            style="@style/Truco.MesaPainel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/mesa_margem">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNomeJ2"
                    style="@style/Truco.Tag.J2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="190dp"
                    android:maxLines="1"
                    android:text="@string/nome_jogador_2" />

                <TextView
                    android:id="@+id/tvVitoriasJ2"
                    style="@style/Truco.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    tools:text="VITÓRIAS 0" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/zonaPlacarJ2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Fogo da sequência: desenhado antes da caixa, então fica atrás dela -->
                <ImageView
                    android:id="@+id/ivFogoEsqJ2"
                    style="@style/Truco.Fogo"
                    android:contentDescription="@null"
                    android:layout_gravity="start|bottom"
                    android:layout_marginStart="-52dp" />

                <ImageView
                    android:id="@+id/ivFogoDirJ2"
                    style="@style/Truco.Fogo"
                    android:contentDescription="@null"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="-52dp"
                    android:rotationY="180" />

                <FrameLayout
                    android:id="@+id/boxPlacarJ2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false">

                    <TextView
                        android:id="@+id/tvPtsJ2"
                        style="@style/Truco.Placar.J2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pontuacao_jogador_2" />

                    <TextView
                        android:id="@+id/tvGanhoJ2"
                        style="@style/Truco.Ganho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-6dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="invisible"
                        tools:text="+3" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnJ2Um"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_1"
                android:contentDescription="@string/um"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_1" />
            <ImageButton
                android:id="@+id/btnJ2Tres"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_3"
                android:contentDescription="@string/truco"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_3" />
            <ImageButton
                android:id="@+id/btnJ2Seis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_6"
                android:contentDescription="@string/seis"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_6" />
            <ImageButton
                android:id="@+id/btnJ2Nove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_9"
                android:contentDescription="@string/nove"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_9" />
            <ImageButton
                android:id="@+id/btnJ2Doze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carta_espaco"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_carta_12"
                android:contentDescription="@string/doze"
                android:onClick="btnPontuarOnClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_carta_12" />
            </LinearLayout>
        </LinearLayout>

</LinearLayout>
