<?xml version="1.0" encoding="utf-8"?>
<!-- Gerado: campo de texto pixelado. Foco = cor viva; activated = erro. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
    <layer-list>
        <item android:left="6dp" android:top="0dp" android:right="6dp" android:bottom="0dp">
            <shape android:shape="rectangle"><solid android:color="@color/error_text" /></shape>
        </item>
        <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
            <shape android:shape="rectangle"><solid android:color="@color/error_text" /></shape>
        </item>
        <item android:left="0dp" android:top="6dp" android:right="0dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/error_text" /></shape>
        </item>
        <item android:left="6dp" android:top="3dp" android:right="6dp" android:bottom="3dp">
            <shape android:shape="rectangle"><solid android:color="@color/panel_dark" /></shape>
        </item>
        <item android:left="3dp" android:top="6dp" android:right="3dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/panel_dark" /></shape>
        </item>
    </layer-list>
    </item>
    <item android:state_focused="true">
    <layer-list>
        <item android:left="6dp" android:top="0dp" android:right="6dp" android:bottom="0dp">
            <shape android:shape="rectangle"><solid android:color="@color/red" /></shape>
        </item>
        <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
            <shape android:shape="rectangle"><solid android:color="@color/red" /></shape>
        </item>
        <item android:left="0dp" android:top="6dp" android:right="0dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/red" /></shape>
        </item>
        <item android:left="6dp" android:top="3dp" android:right="6dp" android:bottom="3dp">
            <shape android:shape="rectangle"><solid android:color="@color/panel_dark" /></shape>
        </item>
        <item android:left="3dp" android:top="6dp" android:right="3dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/panel_dark" /></shape>
        </item>
    </layer-list>
    </item>
    <item>
    <layer-list>
        <item android:left="6dp" android:top="0dp" android:right="6dp" android:bottom="0dp">
            <shape android:shape="rectangle"><solid android:color="@color/red_dark" /></shape>
        </item>
        <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
            <shape android:shape="rectangle"><solid android:color="@color/red_dark" /></shape>
        </item>
        <item android:left="0dp" android:top="6dp" android:right="0dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/red_dark" /></shape>
        </item>
        <item android:left="6dp" android:top="3dp" android:right="6dp" android:bottom="3dp">
            <shape android:shape="rectangle"><solid android:color="@color/panel_dark" /></shape>
        </item>
        <item android:left="3dp" android:top="6dp" android:right="3dp" android:bottom="6dp">
            <shape android:shape="rectangle"><solid android:color="@color/panel_dark" /></shape>
        </item>
    </layer-list>
    </item>
</selector>
